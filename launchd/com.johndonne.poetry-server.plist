<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.johndonne.poetry-server</string>

    <!-- Build and register this app with build_poetry_app.py before loading
         the agent so macOS can present its Local Network permission prompt. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.johndonne.poetry-server</string>
    </array>

    <!-- Python is executed from the locally signed Poetry Server app. The
         checkout lives on an external volume, so this exact app
         needs access under macOS Privacy & Security. A path containing a space
         needs no quoting because each argument is its own array element.
         server.py chdirs to its own directory at startup, which is why no
         WorkingDirectory is needed; it reads the bind address and port from
         config.json, and its own API keys from .env, which is why no --host,
         --port, or shell-sourced environment is passed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Disk B/john-donne/launchd/Poetry Server.app/Contents/MacOS/PoetryServer</string>
        <string>-u</string>
        <string>/Volumes/Disk B/john-donne/server.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/michaelbernaski/Library/Logs/poetry-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaelbernaski/Library/Logs/poetry-server.error.log</string>
</dict>
</plist>
