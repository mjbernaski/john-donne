<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.johndonne.poetry-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lic</string>
        <string>exec /opt/homebrew/bin/python3 -u /Users/michaelbernaski/Developer/john-donne/server.py --host 0.0.0.0 --port 8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/michaelbernaski/Developer/john-donne</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/michaelbernaski/Developer/john-donne/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaelbernaski/Developer/john-donne/server.error.log</string>
</dict>
</plist>
