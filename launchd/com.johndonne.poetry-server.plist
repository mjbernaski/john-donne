<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.johndonne.poetry-server</string>

    <!-- The checkout lives on a volume whose name contains a space, so the
         path is quoted inside the shell command. server.py chdirs to its own
         directory at startup, which is why no WorkingDirectory is needed, and
         it reads the bind address and port from config.json, which is why no
         --host or --port is passed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lic</string>
        <string>exec /usr/local/bin/python3 -u "/Volumes/Disk B/john-donne/server.py"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/michaelbernaski/Library/Logs/poetry-server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaelbernaski/Library/Logs/poetry-server.error.log</string>
</dict>
</plist>
